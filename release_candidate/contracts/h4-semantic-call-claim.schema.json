{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q3ds.local/contracts/solidworks-five-skill-semantic-call-claim-1.0.schema.json",
  "title": "Five-Skill Semantic Call Claim 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id", "schema_version", "session_manifest_sha256", "sequence",
    "tool", "arguments_sha256"
  ],
  "properties": {
    "protocol_id": { "const": "solidworks-five-skill-semantic-call-claim" },
    "schema_version": { "const": "1.0" },
    "session_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 16 },
    "tool": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,95}$" },
    "arguments_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
