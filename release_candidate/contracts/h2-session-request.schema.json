{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q3ds.local/contracts/solidworks-five-skill-session-request-1.0.schema.json",
  "title": "Five-Skill Production Session Request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id", "schema_version", "solidworks_revision", "git_commit",
    "h0_readiness", "execution_service", "source_model", "drawing_template",
    "session_root"
  ],
  "properties": {
    "protocol_id": { "const": "solidworks-five-skill-session-request" },
    "schema_version": { "const": "1.0" },
    "solidworks_revision": { "const": "33.5.0" },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "h0_readiness": { "$ref": "#/$defs/artifact" },
    "execution_service": { "$ref": "#/$defs/artifact" },
    "source_model": { "$ref": "#/$defs/artifact" },
    "drawing_template": { "$ref": "#/$defs/artifact" },
    "session_root": { "type": "string", "minLength": 3 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 3 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
