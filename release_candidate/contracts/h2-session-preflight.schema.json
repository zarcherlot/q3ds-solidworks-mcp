{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q3ds.local/contracts/solidworks-five-skill-session-preflight-1.0.schema.json",
  "title": "Five-Skill Production Session Preflight 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id", "schema_version", "solidworks_revision", "status",
    "git_commit", "h0_readiness", "execution_service", "source_model",
    "drawing_template", "session_root", "planned_outputs", "schedule",
    "solidworks_contacted", "blockers"
  ],
  "properties": {
    "protocol_id": { "const": "solidworks-five-skill-session-preflight" },
    "schema_version": { "const": "1.0" },
    "solidworks_revision": { "const": "33.5.0" },
    "status": { "enum": ["ready", "blocked"] },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "h0_readiness": { "$ref": "#/$defs/artifact" },
    "execution_service": { "$ref": "#/$defs/artifact" },
    "source_model": { "$ref": "#/$defs/artifact" },
    "drawing_template": { "$ref": "#/$defs/artifact" },
    "session_root": { "type": "string", "minLength": 3 },
    "planned_outputs": {
      "type": "object", "additionalProperties": false,
      "required": [
        "initializer_directory", "initializer_handoff", "blank_drawing", "view_plan",
        "view_drawing", "view_verification_sidecar", "dimension_directory",
        "dimension_handoff", "dimension_plan", "dimension_drawing",
        "dimension_verification_sidecar", "layout_directory", "layout_handoff",
        "layout_plan", "final_drawing", "final_verification_sidecar",
        "response_directory", "stage_directory", "h1_candidate"
      ],
      "properties": {
        "initializer_directory": { "type": "string", "minLength": 3 },
        "initializer_handoff": { "type": "string", "minLength": 3 },
        "blank_drawing": { "type": "string", "minLength": 3 },
        "view_plan": { "type": "string", "minLength": 3 },
        "view_drawing": { "type": "string", "minLength": 3 },
        "view_verification_sidecar": { "type": "string", "minLength": 3 },
        "dimension_directory": { "type": "string", "minLength": 3 },
        "dimension_handoff": { "type": "string", "minLength": 3 },
        "dimension_plan": { "type": "string", "minLength": 3 },
        "dimension_drawing": { "type": "string", "minLength": 3 },
        "dimension_verification_sidecar": { "type": "string", "minLength": 3 },
        "layout_directory": { "type": "string", "minLength": 3 },
        "layout_handoff": { "type": "string", "minLength": 3 },
        "layout_plan": { "type": "string", "minLength": 3 },
        "final_drawing": { "type": "string", "minLength": 3 },
        "final_verification_sidecar": { "type": "string", "minLength": 3 },
        "response_directory": { "type": "string", "minLength": 3 },
        "stage_directory": { "type": "string", "minLength": 3 },
        "h1_candidate": { "type": "string", "minLength": 3 }
      }
    },
    "schedule": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sequence", "stage_order", "skill", "tool", "mutating"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1, "maximum": 16 },
          "stage_order": { "type": "integer", "minimum": 1, "maximum": 5 },
          "skill": { "type": "string", "minLength": 3 },
          "tool": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,95}$" },
          "mutating": { "type": "boolean" }
        }
      }
    },
    "solidworks_contacted": { "const": false },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "message", "references"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$" },
          "message": { "type": "string", "minLength": 3 },
          "references": {
            "type": "array", "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 3 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
