{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q3ds.local/contracts/solidworks-five-skill-stage-capture-1.0.schema.json",
  "title": "Five-Skill Stage Artifact Capture 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id", "schema_version", "captured_at_utc", "session_manifest_sha256",
    "order", "skill", "inputs", "outputs"
  ],
  "properties": {
    "protocol_id": { "const": "solidworks-five-skill-stage-capture" },
    "schema_version": { "const": "1.0" },
    "captured_at_utc": { "type": "string", "format": "date-time" },
    "session_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "order": { "type": "integer", "minimum": 1, "maximum": 5 },
    "skill": { "type": "string", "minLength": 3 },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/namedArtifact" } },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/namedArtifact" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "namedArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "sha256"],
      "properties": {
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "path": { "type": "string", "minLength": 3 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
