{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q3ds.local/contracts/dimension-planning-handoff.schema.json",
  "title": "Immutable Dimension Planning Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "schema_version",
    "handoff_id",
    "created_at_utc",
    "status",
    "source_request_sha256",
    "upstream_artifacts",
    "source_model",
    "drawing_context",
    "views",
    "model_driven_dimensions",
    "pmi_annotations",
    "manufacturing_features",
    "approved_user_inputs",
    "reference_measurements",
    "dimension_zones",
    "limitations",
    "source_immutability"
  ],
  "properties": {
    "protocol_id": { "const": "solidworks-dimension-planning-handoff" },
    "schema_version": { "const": "1.0" },
    "handoff_id": { "$ref": "#/$defs/id" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "status": { "const": "ready" },
    "source_request_sha256": { "$ref": "#/$defs/sha256" },
    "upstream_artifacts": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/immutableArtifact" }
    },
    "source_model": { "$ref": "#/$defs/sourceModel" },
    "drawing_context": { "$ref": "#/$defs/drawingContext" },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/view" }
    },
    "model_driven_dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/modelDimension" }
    },
    "pmi_annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/pmiAnnotation" }
    },
    "manufacturing_features": {
      "type": "array",
      "items": { "$ref": "#/$defs/manufacturingFeature" }
    },
    "approved_user_inputs": {
      "type": "array",
      "items": { "$ref": "dimension-planning-handoff-request.schema.json#/$defs/approvedUserInput" }
    },
    "reference_measurements": {
      "type": "array",
      "items": { "$ref": "#/$defs/referenceMeasurement" }
    },
    "dimension_zones": { "type": "array", "items": { "type": "object" } },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_text_bounds", "reference_measurements_are_manufacturing_requirements"],
      "properties": {
        "annotation_text_bounds": { "const": "unsupported_exact" },
        "reference_measurements_are_manufacturing_requirements": { "const": false }
      }
    },
    "source_immutability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drawing_opened_read_only", "source_documents_clean", "hashes_unchanged"],
      "properties": {
        "drawing_opened_read_only": { "const": true },
        "source_documents_clean": { "const": true },
        "hashes_unchanged": { "const": true }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "numberArray": { "type": "array", "items": { "type": "number" } },
    "point2": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "rect2": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
    "immutableArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256_before", "sha256_after"],
      "properties": {
        "role": { "enum": ["view_plan", "verified_drawing", "verification_sidecar", "source_model"] },
        "path": { "type": "string", "minLength": 3 },
        "sha256_before": { "$ref": "#/$defs/sha256" },
        "sha256_after": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "configuration", "save_flag", "persistent_reference_domain"],
      "properties": {
        "path": { "type": "string", "minLength": 3 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "configuration": { "type": "string", "minLength": 1 },
        "save_flag": { "const": false },
        "persistent_reference_domain": { "const": "source_model" }
      }
    },
    "drawingContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sheet_name", "sheet_bounds_m", "projection_method", "sheet_scale"],
      "properties": {
        "path": { "type": "string", "minLength": 3 },
        "sheet_name": { "type": "string", "minLength": 1 },
        "sheet_bounds_m": { "$ref": "#/$defs/rect2" },
        "projection_method": { "enum": ["first_angle", "third_angle"] },
        "sheet_scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view_id", "solidworks_name", "bounds_sheet_m", "referenced_model", "configuration", "projected_geometry", "existing_annotations"],
      "properties": {
        "view_id": { "$ref": "#/$defs/id" },
        "solidworks_name": { "type": "string", "minLength": 1 },
        "bounds_sheet_m": { "$ref": "#/$defs/rect2" },
        "referenced_model": { "type": "string", "minLength": 1 },
        "configuration": { "type": "string", "minLength": 1 },
        "projected_geometry": { "type": "array", "items": { "$ref": "#/$defs/projectedEntity" } },
        "existing_annotations": { "type": "array", "items": { "$ref": "#/$defs/existingAnnotation" } }
      }
    },
    "projectedEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "entity_kind", "model_persistent_reference", "persistent_reference_kind", "geometry_sheet_m", "source_tier"],
      "properties": {
        "entity_id": { "$ref": "#/$defs/id" },
        "entity_kind": { "enum": ["line", "circle", "arc", "other_curve", "silhouette_line", "silhouette_circle", "silhouette_arc"] },
        "model_persistent_reference": { "type": ["string", "null"] },
        "persistent_reference_kind": { "enum": ["entity", "backing_face"] },
        "geometry_sheet_m": { "$ref": "#/$defs/numberArray" },
        "source_tier": { "const": "model_or_pmi" }
      }
    },
    "existingAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_id", "type", "position_sheet_m", "display_envelope_sheet_m", "text_bounds_exact"],
      "properties": {
        "annotation_id": { "$ref": "#/$defs/id" },
        "type": { "type": "integer" },
        "position_sheet_m": { "$ref": "#/$defs/numberArray" },
        "display_envelope_sheet_m": { "oneOf": [{ "$ref": "#/$defs/rect2" }, { "type": "null" }] },
        "text_bounds_exact": { "const": false }
      }
    },
    "modelDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension_id", "full_name", "value_si", "source_tier", "provenance"],
      "properties": {
        "dimension_id": { "$ref": "#/$defs/id" },
        "full_name": { "type": "string", "minLength": 1 },
        "value_si": { "type": "number" },
        "native_type": { "type": "integer" },
        "marked_for_drawing": { "type": "boolean" },
        "reference_dimension": { "type": "boolean" },
        "manufacturing_requirement": { "type": "boolean" },
        "owner_feature_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "owner_feature_name": { "type": ["string", "null"] },
        "owner_feature_type": { "type": ["string", "null"] },
        "owner_feature_persistent_reference": { "type": ["string", "null"] },
        "import_candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/modelDimensionImportCandidate" }
        },
        "source_tier": { "const": "model_or_pmi" },
        "provenance": { "const": "model_driven_dimension" }
      }
    },
    "modelDimensionImportCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id", "native_type", "is_hole_callout", "position_sheet_m",
        "attachment_entity_ids", "model_persistent_references"
      ],
      "properties": {
        "view_id": { "$ref": "#/$defs/id" },
        "native_type": { "type": "integer" },
        "is_hole_callout": { "type": "boolean" },
        "position_sheet_m": { "$ref": "#/$defs/point2" },
        "attachment_entity_ids": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        },
        "model_persistent_references": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pmiAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_id", "type", "source_tier", "provenance", "persistent_references"],
      "properties": {
        "annotation_id": { "$ref": "#/$defs/id" },
        "type": { "type": "integer" },
        "source_tier": { "const": "model_or_pmi" },
        "provenance": { "const": "model_pmi" },
        "persistent_references": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "manufacturingFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "name", "type_name", "classification", "persistent_reference", "source_tier"],
      "properties": {
        "feature_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "type_name": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["hole", "slot", "linear_pattern", "circular_pattern", "model_feature"] },
        "persistent_reference": { "type": "string", "minLength": 1 },
        "source_tier": { "const": "model_or_pmi" }
      }
    },
    "referenceMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_id", "view_id", "kind", "value_si", "entity_ids", "source_tier", "manufacturing_requirement"],
      "properties": {
        "measurement_id": { "$ref": "#/$defs/id" },
        "view_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["projected_line_length", "projected_circle_radius"] },
        "value_si": { "type": "number", "minimum": 0 },
        "entity_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "source_tier": { "const": "reference_geometry_measurement" },
        "manufacturing_requirement": { "const": false }
      }
    }
  }
}
