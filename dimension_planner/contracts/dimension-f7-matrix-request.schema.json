{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q3ds.local/contracts/solidworks-dimension-f7-matrix-request-1.0.schema.json",
  "title": "Dimension F7 Live Matrix Request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id", "schema_version", "solidworks_revision", "f0_evidence", "cases"
  ],
  "properties": {
    "protocol_id": { "const": "solidworks-dimension-f7-matrix-request" },
    "schema_version": { "const": "1.0" },
    "solidworks_revision": { "const": "33.5.0" },
    "f0_evidence": { "$ref": "#/$defs/artifact" },
    "cases": {
      "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 3 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": [
        "case_id", "category", "plan_path", "plan_file_sha256",
        "plan_canonical_sha256", "planning_request", "planning_request_sha256",
        "output_path", "evidence_path"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/id" },
        "category": {
          "enum": ["plate", "shaft_sleeve", "bracket", "flange", "slot_cavity", "threaded"]
        },
        "plan_path": { "type": "string", "minLength": 3 },
        "plan_file_sha256": { "$ref": "#/$defs/sha256" },
        "plan_canonical_sha256": { "$ref": "#/$defs/sha256" },
        "planning_request": {
          "$ref": "https://q3ds.local/contracts/dimension-planning-request.schema.json"
        },
        "planning_request_sha256": { "$ref": "#/$defs/sha256" },
        "output_path": { "type": "string", "minLength": 3 },
        "evidence_path": { "type": "string", "minLength": 3 }
      }
    }
  }
}
