{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q3ds.local/contracts/layout-boundary-qualification.schema.json",
  "title": "SolidWorks G0 Layout Boundary Qualification",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_id", "schema_version", "qualification_id", "created_at", "solidworks_revision", "base_matrix", "supplemental_evidence", "capabilities", "overall_status"],
  "properties": {
    "protocol_id": { "const": "solidworks-layout-g0-qualification" },
    "schema_version": { "const": "1.0" },
    "qualification_id": { "type": "string", "minLength": 3 },
    "created_at": { "type": "string", "format": "date-time" },
    "solidworks_revision": { "const": "33.5.0" },
    "base_matrix": { "$ref": "#/$defs/artifact" },
    "supplemental_evidence": {
      "type": "array", "minItems": 3, "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "capabilities": {
      "type": "array", "minItems": 11, "maxItems": 11,
      "items": { "$ref": "#/$defs/capability" }
    },
    "overall_status": { "const": "complete" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 3 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "capabilityId": {
      "enum": [
        "view_outline_bounds", "dimension_display_bounds", "note_text_bounds",
        "leader_bounds", "view_label_bounds", "section_symbol_bounds",
        "center_element_bounds", "sheet_border_bounds", "title_block_bounds",
        "rebuild_drift", "save_reopen_drift"
      ]
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "evidence_paths", "max_drift_m", "limitation"],
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "status": { "enum": ["supported", "unsupported"] },
        "evidence_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "max_drift_m": { "type": ["number", "null"], "minimum": 0 },
        "limitation": { "type": ["string", "null"] }
      }
    }
  }
}
