{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q3ds.local/contracts/solidworks-drawing-layout-g7-case-evidence-1.0.schema.json",
  "title": "Drawing Layout G7 Case Evidence 1.0",
  "oneOf": [{ "$ref": "#/$defs/positiveEvidence" }, { "$ref": "#/$defs/negativeEvidence" }],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scenario": { "enum": ["sparse_dimensions", "multi_view", "section_view", "detail_view", "auxiliary_view", "hole_pattern", "high_density_dimensions", "scale_change", "authorized_sheet_format"] },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["ok", "status", "planning_request_sha256", "source_dimension_request_sha256", "plan_canonical_sha256"],
      "properties": {
        "ok": { "const": true }, "status": { "enum": ["VALID", "COMPLETED"] },
        "planning_request_sha256": { "$ref": "#/$defs/sha256" },
        "source_dimension_request_sha256": { "$ref": "#/$defs/sha256" },
        "plan_canonical_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "positiveEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol_id", "schema_version", "evidence_kind", "case_id", "scenario", "generated_at_utc", "solidworks_revision", "execution_service_sha256", "capability_manifest_sha256", "plan", "output", "operation_kinds", "stages", "invariants"],
      "properties": {
        "protocol_id": { "const": "solidworks-drawing-layout-g7-case-evidence" }, "schema_version": { "const": "1.0" }, "evidence_kind": { "const": "positive" },
        "case_id": { "$ref": "#/$defs/id" }, "scenario": { "$ref": "#/$defs/scenario" },
        "generated_at_utc": { "type": "string", "format": "date-time" }, "solidworks_revision": { "const": "33.5.0" },
        "execution_service_sha256": { "$ref": "#/$defs/sha256" }, "capability_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "plan": {
          "type": "object", "additionalProperties": false,
          "required": ["plan_id", "path", "file_sha256", "canonical_sha256", "planning_request_sha256", "source_dimension_request_sha256"],
          "properties": { "plan_id": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 3 }, "file_sha256": { "$ref": "#/$defs/sha256" }, "canonical_sha256": { "$ref": "#/$defs/sha256" }, "planning_request_sha256": { "$ref": "#/$defs/sha256" }, "source_dimension_request_sha256": { "$ref": "#/$defs/sha256" } }
        },
        "output": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256", "verification_sidecar_path", "verification_sidecar_sha256"],
          "properties": { "path": { "type": "string", "minLength": 3 }, "sha256": { "$ref": "#/$defs/sha256" }, "verification_sidecar_path": { "type": "string", "minLength": 3 }, "verification_sidecar_sha256": { "$ref": "#/$defs/sha256" } }
        },
        "operation_kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["move_dimension", "move_annotation", "route_leader", "move_view", "set_dimension_hierarchy", "set_view_scale", "set_sheet_scale", "set_sheet_format"] } },
        "stages": { "type": "object", "additionalProperties": false, "required": ["validate", "create", "verify"], "properties": { "validate": { "$ref": "#/$defs/stage" }, "create": { "$ref": "#/$defs/stage" }, "verify": { "$ref": "#/$defs/stage" } } },
        "invariants": {
          "type": "object", "additionalProperties": false,
          "required": ["dimension_semantics_preserved", "view_semantics_preserved", "object_identities_preserved", "no_dangling_leaders", "safe_area_clear", "no_positive_area_collisions", "source_hashes_unchanged", "save_close_readonly_reopen", "independent_readonly_verify", "layout_fingerprint_match"],
          "properties": { "dimension_semantics_preserved": { "const": true }, "view_semantics_preserved": { "const": true }, "object_identities_preserved": { "const": true }, "no_dangling_leaders": { "const": true }, "safe_area_clear": { "const": true }, "no_positive_area_collisions": { "const": true }, "source_hashes_unchanged": { "const": true }, "save_close_readonly_reopen": { "const": true }, "independent_readonly_verify": { "const": true }, "layout_fingerprint_match": { "const": true } }
        }
      }
    },
    "negativeEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol_id", "schema_version", "evidence_kind", "case_id", "scenario", "generated_at_utc", "planning_request_sha256", "status", "issue_code"],
      "properties": {
        "protocol_id": { "const": "solidworks-drawing-layout-g7-case-evidence" }, "schema_version": { "const": "1.0" }, "evidence_kind": { "const": "negative" },
        "case_id": { "$ref": "#/$defs/id" }, "scenario": { "const": "unauthorized_sheet_format" }, "generated_at_utc": { "type": "string", "format": "date-time" },
        "planning_request_sha256": { "$ref": "#/$defs/sha256" }, "status": { "const": "rejected" }, "issue_code": { "const": "sheet-format-unauthorized" }
      }
    }
  }
}
