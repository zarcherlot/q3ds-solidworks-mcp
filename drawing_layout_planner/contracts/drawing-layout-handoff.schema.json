{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q3ds.local/contracts/drawing-layout-handoff.schema.json",
  "title": "Immutable Drawing Layout Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_id", "schema_version", "handoff_id", "created_at_utc", "status", "source_request_sha256", "upstream_artifacts", "dimension_semantics", "solidworks", "sheet", "objects", "constraints", "minimum_spacing_m", "boundary_capabilities", "snapshots", "source_immutability", "blockers"],
  "properties": {
    "protocol_id": { "const": "solidworks-drawing-layout-handoff" },
    "schema_version": { "const": "1.0" },
    "handoff_id": { "$ref": "#/$defs/id" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "status": { "enum": ["ready", "capability_blocked"] },
    "source_request_sha256": { "$ref": "#/$defs/sha256" },
    "upstream_artifacts": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/immutableArtifact" } },
    "dimension_semantics": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "planned_count", "verified_actual_count", "invariant_sha256", "dimensions"],
      "properties": {
        "plan_id": { "$ref": "#/$defs/id" },
        "planned_count": { "type": "integer", "minimum": 1 },
        "verified_actual_count": { "type": "integer", "minimum": 1 },
        "invariant_sha256": { "$ref": "#/$defs/sha256" },
        "dimensions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dimensionInvariant" } }
      }
    },
    "solidworks": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "execution_mode"],
      "properties": { "revision": { "type": "string", "minLength": 1 }, "execution_mode": { "const": "live_read_only" } }
    },
    "sheet": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "bounds_m", "safe_bounds_m"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "bounds_m": { "$ref": "#/$defs/rect" },
        "safe_bounds_m": { "$ref": "#/$defs/rect" },
        "scale_numerator": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "scale_denominator": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "objects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/boundaryObject" } },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["locked_zones", "frozen_objects", "view_constraints", "view_parentage", "projection_alignments"],
      "properties": {
        "locked_zones": { "type": "array", "items": { "$ref": "#/$defs/lockedZone" } },
        "frozen_objects": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "view_constraints": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "view_parentage": { "type": "array", "items": { "type": "object" } },
        "projection_alignments": { "type": "array", "items": { "type": "object" } }
      }
    },
    "minimum_spacing_m": { "$ref": "drawing-layout-handoff-request.schema.json#/properties/minimum_spacing_m" },
    "boundary_capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["registry_version", "verification", "qualification_id", "required", "unsupported"],
      "properties": {
        "registry_version": { "type": "string", "minLength": 1 },
        "verification": { "const": "live_complete" },
        "qualification_id": { "$ref": "#/$defs/id" },
        "required": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "unsupported": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "snapshots": {
      "type": "object", "additionalProperties": false,
      "required": ["before_rebuild_sha256", "after_rebuild_sha256", "readonly_reopen_sha256", "object_identity_stable"],
      "properties": {
        "before_rebuild_sha256": { "$ref": "#/$defs/sha256" },
        "after_rebuild_sha256": { "$ref": "#/$defs/sha256" },
        "readonly_reopen_sha256": { "$ref": "#/$defs/sha256" },
        "object_identity_stable": { "const": true }
      }
    },
    "source_immutability": {
      "type": "object", "additionalProperties": false,
      "required": ["drawing_opened_read_only", "drawing_saved", "hashes_unchanged", "dimension_count_unchanged", "dimension_values_unchanged", "dimension_attachments_unchanged"],
      "properties": {
        "drawing_opened_read_only": { "const": true }, "drawing_saved": { "const": false }, "hashes_unchanged": { "const": true },
        "dimension_count_unchanged": { "const": true }, "dimension_values_unchanged": { "const": true }, "dimension_attachments_unchanged": { "const": true }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rect": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
    "immutableArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "sha256_before", "sha256_after"],
      "properties": {
        "role": { "enum": ["dimension_plan", "dimensioned_drawing", "dimension_verification_sidecar", "boundary_capability_manifest", "boundary_qualification"] },
        "path": { "type": "string", "minLength": 3 }, "sha256_before": { "$ref": "#/$defs/sha256" }, "sha256_after": { "$ref": "#/$defs/sha256" }
      }
    },
    "dimensionInvariant": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension_id", "value_si", "model_persistent_references"],
      "properties": {
        "dimension_id": { "$ref": "#/$defs/id" }, "value_si": { "type": "number" },
        "model_persistent_references": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "boundaryObject": {
      "type": "object", "additionalProperties": true,
      "required": ["id", "category", "view", "bounds", "source_api", "exact", "collision_usable"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "category": { "$ref": "#/$defs/id" }, "view": { "type": "string", "minLength": 1 },
        "bounds": { "$ref": "#/$defs/rect" }, "source_api": { "type": "string", "minLength": 1 }, "exact": { "type": "boolean" }, "collision_usable": { "type": "boolean" }
      }
    },
    "lockedZone": {
      "type": "object", "additionalProperties": false,
      "required": ["zone_id", "kind", "bounds_m"],
      "properties": { "zone_id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["sheet_frame", "title_block"] }, "bounds_m": { "$ref": "#/$defs/rect" } }
    }
  }
}
