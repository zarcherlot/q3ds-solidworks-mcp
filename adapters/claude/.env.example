# Copy this file to adapters/claude/.env for local overrides.
# The defaults below match the adapter's built-in settings.

EXECUTION_BASE_URL=http://localhost:5000
HTTP_TIMEOUT=30
SIMULATION_TIMEOUT=600
ENSURE_TIMEOUT=120
HOST_BOOTSTRAP_TIMEOUT_MARGIN=90
SERVER_SPAWN_TIMEOUT=20

# Optional server-side MCP Sampling fallback. Client-provided Sampling remains preferred.
# Disabled by default. Never commit a real key; put local values only in adapters/claude/.env.
PLANNER_SAMPLING_FALLBACK_ENABLED=false
# PLANNER_SAMPLING_API_KEY=
# PLANNER_SAMPLING_MODEL=
# Optional OpenAI-compatible Chat Completions API root; omit for the official OpenAI API.
# The endpoint/model must support image inputs and required function/tool calling.
# PLANNER_SAMPLING_BASE_URL=https://api.openai.com/v1

# Optional local default used only when planner_profile=debug and the request omits
# debug_prompt_directory. Use an absolute path; production never reads this prompt directory.
# PLANNER_DEBUG_PROMPT_DIRECTORY=C:/src/solidpilot/prompt_lab/mechanical-2d-drawing

# Leave unset to use the standard Debug build under this repository.
# Use forward slashes in a custom Windows path to avoid escape ambiguity.
# EXECUTION_EXE_PATH=C:/src/solidpilot/solidworks-execution/SolidworksExecution/bin/Debug/SolidworksExecution.exe
