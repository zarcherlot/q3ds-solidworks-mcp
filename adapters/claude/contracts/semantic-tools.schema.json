{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Q3DS SolidWorks semantic MCP tools",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "solidworks_status",
    "inspect_solidworks_host",
    "bootstrap_solidworks_host",
    "inspect_part_for_drawing",
    "initialize_part_drawing_handoff",
    "plan_part_drawing_views",
    "publish_validated_part_drawing_view_plan",
    "validate_part_drawing_view_plan",
    "create_part_drawing_from_view_plan",
    "verify_part_drawing_view_plan",
    "initialize_part_drawing_dimension_handoff",
    "publish_validated_part_drawing_dimension_plan",
    "validate_part_drawing_dimension_plan",
    "create_dimensioned_part_drawing",
    "verify_dimensioned_part_drawing"
  ],
  "properties": {
    "solidworks_status": {
      "$ref": "#/$defs/tool",
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "launch_if_needed": { "type": "boolean", "default": false } }
        }
      }
    },
    "inspect_solidworks_host": {
      "$ref": "#/$defs/tool",
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["output_directory"],
          "properties": {
            "output_directory": { "type": "string", "minLength": 1 },
            "drawing_template_path": {
              "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }],
              "default": null
            }
          }
        }
      }
    },
    "bootstrap_solidworks_host": {
      "$ref": "#/$defs/tool",
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["output_directory"],
          "properties": {
            "output_directory": { "type": "string", "minLength": 1 },
            "drawing_template_path": {
              "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }],
              "default": null
            },
            "allow_registration_repair": { "type": "boolean", "default": false },
            "visible": { "type": "boolean", "default": false },
            "keep_solidworks_running": { "type": "boolean", "default": false },
            "com_timeout_seconds": { "type": "integer", "minimum": 10, "maximum": 600, "default": 180 },
            "regserver_timeout_seconds": { "type": "integer", "minimum": 10, "maximum": 300, "default": 120 }
          }
        }
      }
    },
    "inspect_part_for_drawing": {
      "$ref": "#/$defs/tool",
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_path"],
          "properties": { "model_path": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "initialize_part_drawing_handoff": {
      "$ref": "#/$defs/tool",
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_path", "drawing_template_path", "publication_directory"],
          "properties": {
            "model_path": { "type": "string", "minLength": 1 },
            "drawing_template_path": { "type": "string", "minLength": 1 },
            "publication_directory": { "type": "string", "minLength": 1 },
            "image_width": { "type": "integer", "minimum": 320, "maximum": 2000, "default": 1024 },
            "image_height": { "type": "integer", "minimum": 240, "maximum": 2000, "default": 768 }
          }
        }
      }
    },
    "plan_part_drawing_views": {
      "$ref": "#/$defs/planningTool"
    },
    "publish_validated_part_drawing_view_plan": {
      "$ref": "#/$defs/viewPlanRequestTool"
    },
    "validate_part_drawing_view_plan": {
      "$ref": "#/$defs/viewPlanRequestTool"
    },
    "create_part_drawing_from_view_plan": {
      "$ref": "#/$defs/tool",
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan", "request", "output_path"],
          "properties": {
            "plan": { "$ref": "https://local.example/schemas/solidworks/view-plan/1.4" },
            "request": { "$ref": "https://q3ds.dev/contracts/solidworks/view-planning-request-1.0.schema.json" },
            "output_path": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "verify_part_drawing_view_plan": {
      "$ref": "#/$defs/tool",
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan", "request", "output_path"],
          "properties": {
            "plan": { "$ref": "https://local.example/schemas/solidworks/view-plan/1.4" },
            "request": { "$ref": "https://q3ds.dev/contracts/solidworks/view-planning-request-1.0.schema.json" },
            "output_path": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "initialize_part_drawing_dimension_handoff": {
      "$ref": "#/$defs/tool",
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "view_plan_path",
            "verified_drawing_path",
            "verification_sidecar_path",
            "publication_directory"
          ],
          "properties": {
            "view_plan_path": { "type": "string", "minLength": 1 },
            "verified_drawing_path": { "type": "string", "minLength": 1 },
            "verification_sidecar_path": { "type": "string", "minLength": 1 },
            "publication_directory": { "type": "string", "minLength": 1 },
            "approved_user_inputs": {
              "type": "array",
              "items": { "$ref": "#/$defs/approvedDimensionInput" },
              "default": []
            }
          }
        }
      }
    },
    "publish_validated_part_drawing_dimension_plan": {
      "$ref": "#/$defs/dimensionPlanRequestTool"
    },
    "validate_part_drawing_dimension_plan": {
      "$ref": "#/$defs/dimensionPlanOutputTool"
    },
    "create_dimensioned_part_drawing": {
      "$ref": "#/$defs/dimensionPlanOutputTool"
    },
    "verify_dimensioned_part_drawing": {
      "$ref": "#/$defs/dimensionPlanOutputTool"
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "parameters"],
      "properties": {
        "description": { "type": "string", "minLength": 20 },
        "parameters": { "type": "object" }
      }
    },
    "planningTool": {
      "allOf": [
        { "$ref": "#/$defs/tool" },
        {
          "properties": {
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["request"],
              "properties": {
                "request": {
                  "$ref": "https://q3ds.dev/contracts/solidworks/view-planning-request-1.0.schema.json"
                }
              }
            }
          }
        }
      ]
    },
    "viewPlanRequestTool": {
      "allOf": [
        { "$ref": "#/$defs/tool" },
        {
          "properties": {
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plan", "request"],
              "properties": {
                "plan": { "$ref": "https://local.example/schemas/solidworks/view-plan/1.4" },
                "request": { "$ref": "https://q3ds.dev/contracts/solidworks/view-planning-request-1.0.schema.json" }
              }
            }
          }
        }
      ]
    },
    "dimensionPlanRequestTool": {
      "allOf": [
        { "$ref": "#/$defs/tool" },
        {
          "properties": {
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plan", "request"],
              "properties": {
                "plan": { "$ref": "https://q3ds.local/contracts/solidworks-dimension-plan-1.0.schema.json" },
                "request": { "$ref": "https://q3ds.local/contracts/dimension-planning-request.schema.json" }
              }
            }
          }
        }
      ]
    },
    "dimensionPlanOutputTool": {
      "allOf": [
        { "$ref": "#/$defs/tool" },
        {
          "properties": {
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["plan", "request", "output_path"],
              "properties": {
                "plan": { "$ref": "https://q3ds.local/contracts/solidworks-dimension-plan-1.0.schema.json" },
                "request": { "$ref": "https://q3ds.local/contracts/dimension-planning-request.schema.json" },
                "output_path": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ]
    },
    "approvedDimensionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_id", "source_tier", "approved_by", "approved_at_utc",
        "approval_reference", "target_feature_ids", "value"
      ],
      "properties": {
        "input_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "source_tier": { "const": "user_confirmed_input" },
        "approved_at_utc": { "type": "string", "format": "date-time" },
        "approved_by": { "type": "string", "minLength": 1 },
        "approval_reference": { "type": "string", "minLength": 1 },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "quantity_kind", "value_si"],
              "properties": {
                "kind": { "const": "quantity" },
                "quantity_kind": { "enum": ["length", "angle", "count"] },
                "value_si": { "type": "number" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "text"],
              "properties": {
                "kind": { "const": "exact_text" },
                "text": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "target_feature_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "uniqueItems": true
        }
      }
    }
  }
}
