      ],
      "success_states": ["ready", "published", "VALID", "COMPLETED"],
      "stop_states": [
        "blocked",
        "rejected",
        "capability_blocked",
        "EXECUTOR_REJECTED",
        "FAILED"
      ]
    }
  ],
  "forbidden_agent_boundaries": [
    "private_executor_tools",
    "raw_http",
    "second_mcp_client",
